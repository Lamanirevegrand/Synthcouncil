# Convenience copy — the authoritative template lives at apps/api/.env.example
# Copy this file to apps/api/.env before running the engine locally.

PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:4321,https://synthcouncil.netlify.app

# LLM — OpenRouter (Groq model by default). Or GROQ_API_KEY for direct Groq,
# or LLM_PROVIDER=mock for a fully offline deterministic demo.
OPENROUTER_API_KEY=
LLM_MODEL=groq/llama-3.3-70b-versatile

# Optional evidence / storage
TAVILY_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

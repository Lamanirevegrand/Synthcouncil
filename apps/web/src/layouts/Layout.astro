---
import "../styles/global.css";
import WebMCPRegistrar from "../components/WebMCPRegistrar";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="SynthCouncil — an adversarial council of AI agents that debates your hardest problem using live, cited web evidence. You hold the gavel."
    />
    <meta name="theme-color" content="#0a0d13" />
    <title>SynthCouncil — The Council of Agents</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand"
          ><img
            src="/logo.svg"
            alt="SynthCouncil Logo"
            class="brand-mark"
          /><span>SynthCouncil</span></a
        >
        <nav class="site-nav">
          <a href="/#how">How it works</a>
          <a href="/#webmcp">WebMCP</a>
          <a
            href="https://github.com/synthcouncil/synthcouncil"
            target="_blank"
            rel="noopener noreferrer">Source</a
          >
        </nav>
      </div>
    </header>

    <!-- Registers the council's WebMCP tools on every page, automatically. -->
    <WebMCPRegistrar client:load />

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        OpenAI <strong>WebMCP</strong> hackathon project · humans and agents, grounded
        in live web evidence · GPL-3.0 licensed
      </p>
    </footer>
  </body>
</html>

---
import Layout from '../layouts/Layout.astro';
import CreateCouncilForm from '../components/CreateCouncilForm';
import WebMCPPanel from '../components/WebMCPPanel';
---

<Layout>
  <section class="hero">
    <p class="eyebrow">Adversarial AI · Live web evidence · Human arbitration</p>
    <h1>The Council of Agents</h1>
    <p class="tagline">
      Four experts — <strong>Tech</strong>, <strong>Finance</strong>, <strong>Risk</strong>,
      <strong>Strategy</strong> — debate your problem with cited web evidence, then stop and wait
      for your verdict.
    </p>
    <div class="hero-chips">
      <span class="chip">🔎 Every claim sourced</span>
      <span class="chip">💥 Positions get attacked</span>
      <span class="chip">🛑 You arbitrate mid-debate</span>
      <span class="chip">🌐 WebMCP native</span>
    </div>
  </section>

  <div class="split">
    <CreateCouncilForm client:load />

    <aside class="card how-card" id="how">
      <div class="how-head">
        <h3>How a session works</h3>
        <span class="pill">≈ 3–5 min</span>
      </div>
      <ol class="how-list">
        <li><b>1 · Convene.</b> State the problem, pick the experts.</li>
        <li><b>2 · Investigate.</b> Agents search the live web, post cited findings.</li>
        <li><b>3 · Debate.</b> Each expert defends its stance, attacks the others.</li>
        <li><b>4 · You arbitrate.</b> The council pauses until you steer it.</li>
        <li><b>5 · Verdict.</b> Recommendations, risks, sources — one clean document.</li>
      </ol>
    </aside>
  </div>

  <WebMCPPanel client:load />

  <section class="strip">
    <div class="strip-item">
      <span class="strip-icon">🔌</span>
      <b>WebMCP native</b>
      <span class="muted">document.modelContext.registerTool — the browser's model can run the council itself.</span>
    </div>
    <div class="strip-item">
      <span class="strip-icon">⚡</span>
      <b>OpenRouter-powered</b>
      <span class="muted">Groq by default; Claude, GPT and more via one key.</span>
    </div>
    <div class="strip-item">
      <span class="strip-icon">🧩</span>
      <b>Zod contracts</b>
      <span class="muted">A hallucinated JSON shape can never break a debate.</span>
    </div>
    <div class="strip-item">
      <span class="strip-icon">🧠</span>
      <b>Blackboard + DAG</b>
      <span class="muted">Agents never talk directly — the orchestrator distributes the floor.</span>
    </div>
  </section>
</Layout>

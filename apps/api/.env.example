# ---------------------------------------------------------------------------
# SynthCouncil API — environment template
# Copy to .env and fill in what you need. Nothing here is mandatory for a
# local offline run: without keys the API falls back to mock LLM + memory
# storage so you can exercise the whole pipeline.
# ---------------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed CORS origins (Astro dev + Netlify prod).
FRONTEND_URL=http://localhost:4321,https://synthcouncil.netlify.app

# ---  LLM configuration -------------------------------------------------------
# Preferred: OpenRouter — one API for Groq, Claude, GPT and many more.
OPENROUTER_API_KEY=
# Default model used by OpenRouter. Fast + cheap via Groq's infra:
LLM_MODEL=groq/llama-3.3-70b-versatile

# Alternative 1: direct Groq (https://console.groq.com/keys)
# GROQ_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# Alternative 2: any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, ...)
# LLM_PROVIDER=custom
# CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

# Alternative 3: deterministic offline mock (no key, labeled "[mock]" output)
# LLM_PROVIDER=mock

LLM_TIMEOUT_MS=90000
SITE_URL=SITE_URL=https://synthcouncil.netlify.app

# --- Evidence / web search ---------------------------------------------------
# Optional: Tavily gives structured results. Without it, the API falls back
# to a key-free DuckDuckGo Lite scrape + Jina Reader page fetching.
TAVILY_API_KEY=
# Force synthetic search results for offline demos/tests:
# SEARCH_MOCK=true
SEARCH_TIMEOUT_MS=15000
FETCH_TIMEOUT_MS=12000

# --- Storage ------------------------------------------------------------------
# Optional: without these, sessions live in memory (lost on restart).
STORAGE=auto
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
